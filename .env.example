# Oakwood Golf Club — environment variables
#
# Copy to .env.local for local development (NOT committed — see .gitignore).
#
# Only SECRETS live in the environment (planning #2879). Host, port, user,
# sender and recipient of the mail, the captcha switch and the public
# Turnstile site key are configuration and live in lib/kontakt-config.ts.
#
# IMPORTANT: both values below are secrets. Never commit them, never log them,
# never paste them into chat / tickets / screenshots. Rotate if exposed.
# In Vercel they are set for Production only, so previews and `npm run dev`
# send no mail and show no captcha widget.

# ----------------------------------------------------------------------------
# IONOS SMTP — the info@ mailbox password, used by all three form Server Actions
# ----------------------------------------------------------------------------
# Without it the actions log the subject line only (dev) or refuse the submit
# (production), see lib/email/send.ts.
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# Cloudflare Turnstile — secret key (server-side siteverify only)
# ----------------------------------------------------------------------------
# Without it the widget does not render and the server skips the check in dev
# and preview; a production build without it rejects every submit (fail-closed).
# Cloudflare test secret (always-pass, local only):
#   1x0000000000000000000000000000000AA
# It needs the test site key 1x00000000000000000000AA in lib/kontakt-config.ts
# for the run (do not commit that), see docs/runbooks/turnstile-activation.md.
TURNSTILE_SECRET_KEY=
